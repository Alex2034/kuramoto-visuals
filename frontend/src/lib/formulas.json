{
  "macros": {
    "\\conj": "\\overline{#1}",
    "\\T": "T",
    "\\D": "\\mathbb{D}",
    "\\bary": "\\operatorname{bary}",
    "\\im": "\\operatorname{Im}",
    "\\re": "\\operatorname{Re}",
    "\\dd": "\\mathrm{d}",
    "\\e": "\\mathrm{e}",
    "\\ii": "\\mathrm{i}"
  },
  "formulas": {
    "eq:alpha-dot": "\\dot\\alpha =-\\lambda\\,\\im\\bigl(\\conj w\\,q\\bigr)",
    "eq:bary-equivariance": "\\bary\\bigl(M(z_1),\\dots,M(z_n)\\bigr)=M\\bigl(\\bary(z_1,\\dots,z_n)\\bigr)",
    "eq:bary-newton": "d=\\frac{m+B\\,\\conj m}{1-|B|^2},\\qquad p\\leftarrow\\T_{-p}(d)=\\frac{d+p}{1+\\conj p\\,d}",
    "eq:barycenter": "\\sum_{j=1}^{n}\\T_p(z_j)=0,\\qquad p=:\\bary(z_1,\\dots,z_n)",
    "eq:calibration": "p_0=\\bary(z_1,\\dots,z_{N-1}),\\qquad \\beta_j=\\T_{p_0}(z_j),\\qquad\nw(0)=-p_0,\\qquad \\zeta(0)=1",
    "eq:center": "P:=-\\zeta\\,w=\\bary(z_1,\\dots,z_{N-1})\\qquad\\text{at every time.}",
    "eq:centered-frame": "\\T_P(z)=\\zeta\\,\\T_{-w}\\bigl(\\conj\\zeta\\,z\\bigr),\\qquad\\text{hence}\\qquad\n\\T_P(z_j)=\\zeta\\,\\beta_j ,\\quad j=1,\\dots,N-1",
    "eq:chain-center": "P_{\\mathrm{chain}}:=\\bary(z_{N+1},\\dots,z_{N+l})",
    "eq:chain-dot": "\\dot\\theta_j =\\kappa\\sin(\\theta_{j-1}-\\theta_j)+\\kappa\\sin(\\theta_{j+1}-\\theta_j),\n\\qquad j=N+1,\\dots,N+l",
    "eq:chi-dot": "\\dot\\chi=\\frac{\\kappa\\,\\sin(\\theta_{N+1}-\\theta_N)}{P(w,\\psi)}",
    "eq:cluster-phase": "\\Theta:=\\alpha+\\varphi+\\pi=\\arg P,\\qquad \\delta:=\\theta_N-\\Theta",
    "eq:collapsed": "\\begin{aligned}\n\\dot\\Theta_1&=\\frac\\lambda N\\sin(\\theta_N-\\Theta_1),\\\\\n\\dot\\theta_N&=\\frac{N-1}{N}\\,\\lambda\\sin(\\Theta_1-\\theta_N)+\\kappa\\sin(\\theta_{N+1}-\\theta_N),\\\\\n\\dot\\theta_j&=\\kappa\\sin(\\theta_{j-1}-\\theta_j)+\\kappa\\sin(\\theta_{j+1}-\\theta_j),\n\\qquad j=N+1,\\dots,N+l,\n\\end{aligned}",
    "eq:complex-attached": "\\dot z_N =\\frac\\lambda2\\bigl(r-\\conj r\\,z_N^2\\bigr)\n+\\frac\\kappa2\\bigl(z_{N+1}-\\conj z_{N+1}\\,z_N^2\\bigr)",
    "eq:complex-chain": "\\dot z_j =\\frac\\kappa2\\Bigl[(z_{j-1}+z_{j+1})-\\conj{(z_{j-1}+z_{j+1})}\\,z_j^2\\Bigr],\n\\qquad j=N+1,\\dots,N+l",
    "eq:complex-identical": "\\dot z_j =\\frac\\lambda2\\bigl(r-\\conj r\\,z_j^2\\bigr), \\qquad j=1,\\dots,N-1",
    "eq:cross-ratio": "(z_1,z_2,z_3,z_4)=\\frac{z_1-z_3}{z_1-z_2}\\cdot\\frac{z_4-z_2}{z_4-z_3}",
    "eq:deficit": "1-|r|^2=\\frac{4}{N^2}\\sum_{i<j}\\sin^2\\frac{\\theta_i-\\theta_j}{2},\\qquad\n1-|r|=\\frac{1-|r|^2}{1+|r|}",
    "eq:deficit-late": "1-|r|^2=\\frac{4(N-1)}{N^2}\\sin^2\\frac\\delta2,\\qquad\n1-|r|\\approx\\frac{N-1}{2N^2}\\,\\delta^2",
    "eq:energy": "E(\\theta)=-\\sum_{i<j}a_{ij}\\cos(\\theta_i-\\theta_j),\\qquad\n\\dot\\theta=-\\nabla E,\\qquad \\dot E=-|\\dot\\theta|^2\\le0",
    "eq:f-dot": "\\frac{\\dd f}{\\dd t}=-\\lambda\\,|r|^2\n+\\frac{2\\kappa}{N}\\cdot\\frac{\\im(\\conj w\\,\\psi)}{1-|w|^2}\\cdot\\sin(\\theta_N-\\theta_{N+1})",
    "eq:full-system": "\\dot\\theta_i=\\sum_{j} a_{ij}\\,\\sin(\\theta_j-\\theta_i),\\qquad\na_{ij}=\\begin{cases}\n\\lambda/N, & i\\neq j \\text{ in the same clique},\\\\\n\\kappa, & i,j \\text{ adjacent on the path } N,\\,N+1,\\dots,N+l+1,\\\\\n0, & \\text{otherwise.}\n\\end{cases}",
    "eq:full-system-explicit": "\\begin{aligned}\n\\dot\\theta_j&=\\frac{\\lambda}{N}\\sum_{i=1}^{N}\\sin(\\theta_i-\\theta_j), && j=1,\\dots,N-1,\\\\\n\\dot\\theta_N&=\\frac{\\lambda}{N}\\sum_{i=1}^{N-1}\\sin(\\theta_i-\\theta_N)+\\kappa\\sin(\\theta_{N+1}-\\theta_N),\\\\\n\\dot\\theta_j&=\\kappa\\sin(\\theta_{j-1}-\\theta_j)+\\kappa\\sin(\\theta_{j+1}-\\theta_j), && j=N+1,\\dots,N+l,\\\\\n\\dot\\theta_{N+l+1}&=\\kappa\\sin(\\theta_{N+l}-\\theta_{N+l+1})+\\frac{\\lambda}{N}\\sum_{i=N+l+2}^{2N+l}\\sin(\\theta_i-\\theta_{N+l+1}),\\\\\n\\dot\\theta_j&=\\frac{\\lambda}{N}\\sum_{i=N+l+1}^{2N+l}\\sin(\\theta_i-\\theta_j), && j=N+l+2,\\dots,2N+l.\n\\end{aligned}",
    "eq:gauge-frame": "\\T_w^{-1}\\bigl(\\conj\\zeta\\,z_j\\bigr)=\\beta_j,\\qquad\n\\T_w^{-1}\\bigl(\\conj\\zeta\\,z_N\\bigr)=\\psi,\\qquad\n\\T_w^{-1}(0)=w",
    "eq:global-center": "P_{\\mathrm{all}}:=\\bary(z_1,\\dots,z_{2N+l}),\\qquad\n\\sum_{j=1}^{2N+l}\\T_{P_{\\mathrm{all}}}(z_j)=0",
    "eq:gradient-flow": "\\dot w=-\\lambda\\,\\nabla_{\\mathbb H}f(w),\\qquad\n\\frac{\\dd f}{\\dd t}=-\\lambda\\,|q|^2=-\\lambda\\,|r|^2\\le0",
    "eq:laplacian": "L=\\operatorname{diag}\\Bigl(\\sum_j a_{ij}\\Bigr)-A,\\qquad\n\\varepsilon^{\\mathsf T}L\\,\\varepsilon=\\sum_{i<j}a_{ij}(\\varepsilon_i-\\varepsilon_j)^2\\ge0",
    "eq:log-one-minus": "\\ln(1-|w|^2)=2\\Bigl[\\ln2-\\frac\\rho2-\\ln\\bigl(1+\\e^{-\\rho}\\bigr)\\Bigr]",
    "eq:microscope": "\\arg z_j-\\Theta=\\arg\\bigl(1-s\\,x_j\\bigr)=:s\\,\\mu_j,\\qquad\nx_j=\\frac{1+u_j}{(1-u_j)+s\\,u_j}",
    "eq:microscope-limit": "\\mu_j\\to-\\cot\\frac{\\gamma_j}{2}\\qquad(\\rho\\to\\infty)",
    "eq:mobius": "\\T_p(z)=\\frac{z-p}{1-\\conj p\\,z},\\qquad \\T_p^{-1}=\\T_{-p},\\qquad \\T_p(p)=0",
    "eq:node-dot": "\\dot\\theta_N =\\lambda\\,\\im\\bigl(r\\,\\e^{-\\ii\\theta_N}\\bigr)+\\kappa\\sin(\\theta_{N+1}-\\theta_N)",
    "eq:order-parameter": "r=\\frac1N\\sum_{j\\in\\text{clique}}\\e^{\\ii\\theta_j},\\qquad 0\\le |r|\\le 1",
    "eq:physical-potential": "F(p)=\\frac1n\\sum_{j=1}^{n}\\ln P(p,z_j)",
    "eq:poisson": "P(w,\\beta)=\\frac{1-|w|^2}{|w-\\beta|^2},\\qquad |\\beta|=1",
    "eq:poisson-gradient": "(1-|w|^2)\\,\\frac{\\partial}{\\partial\\conj w}\\ln P(w,\\beta)=\\T_w(\\beta)",
    "eq:potential": "f(w,\\psi)=\\frac1N\\Bigl[\\,\\sum_{j=1}^{N-1}\\ln P(w,\\beta_j)+\\ln P(w,\\psi)\\Bigr]",
    "eq:potential-complete": "f(w)=\\frac1N\\sum_{j=1}^{N}\\ln P(w,\\beta_j),\\qquad\n\\nabla_{\\mathbb H}=\\tfrac12\\,(1-|w|^2)^2\\,\\frac{\\partial}{\\partial\\conj w}",
    "eq:potential-frames": "F(P)=-f(w,\\psi)",
    "eq:psi-def": "\\psi:=\\T_w^{-1}\\bigl(\\conj\\zeta\\,z_N\\bigr),\\qquad z_N=\\zeta\\,\\T_w(\\psi),\\qquad \\psi=\\e^{\\ii\\chi}",
    "eq:psi-dot": "\\dot\\psi=-\\frac{\\kappa}{2\\,(1-|w|^2)}\n\\Bigl[\\zeta\\,\\conj z_{N+1}\\,(\\psi-w)^2-\\conj\\zeta\\,z_{N+1}\\,(1-\\conj w\\psi)^2\\Bigr]",
    "eq:q-complete": "q:=\\conj\\zeta\\,r=\\frac1N\\sum_{j=1}^{N}\\T_w(\\beta_j),\\qquad |q|=|r|",
    "eq:q-def": "q:=\\conj\\zeta\\,r=\\frac1N\\Bigl[\\,\\sum_{j=1}^{N-1}\\T_w(\\beta_j)+\\conj\\zeta\\,\\e^{\\ii\\theta_N}\\Bigr]",
    "eq:relative": "\\begin{aligned}\n\\dot\\Delta_N&=-\\lambda\\sin\\Delta_N+\\kappa\\sin\\Delta_{N+1},\\\\\n\\dot\\Delta_{N+1}&=\\frac{N-1}{N}\\,\\lambda\\sin\\Delta_N-2\\kappa\\sin\\Delta_{N+1}+\\kappa\\sin\\Delta_{N+2},\\\\\n\\dot\\Delta_j&=\\kappa\\bigl(\\sin\\Delta_{j+1}-2\\sin\\Delta_j+\\sin\\Delta_{j-1}\\bigr),\n\\qquad N+1<j<N+l .\n\\end{aligned}",
    "eq:rho-dot": "\\dot\\rho=-\\lambda\\,\\re\\bigl(\\e^{-\\ii\\varphi}q\\bigr),\\qquad\n\\dot\\varphi=-\\frac{\\lambda}{\\sinh\\rho}\\,\\im\\bigl(\\e^{-\\ii\\varphi}q\\bigr)",
    "eq:rho-late": "\\dot\\rho\\to\\lambda\\Bigl[1-\\frac{1-\\cos\\delta}{N}\\Bigr],\\qquad\n\\dot\\Theta\\to\\frac{\\lambda}{N}\\sin\\delta",
    "eq:riccati": "\\dot\\theta=\\im\\bigl(H\\,\\conj z\\bigr)\n\\qquad\\Longleftrightarrow\\qquad\n\\dot z=\\tfrac12\\bigl(H-\\conj H\\,z^2\\bigr)",
    "eq:s-def": "s:=1-\\tanh\\frac\\rho2=\\frac{2\\,\\e^{-\\rho}}{1+\\e^{-\\rho}},\\qquad\n1-|w|^2=s\\,(2-s)",
    "eq:stable-mobius": "\\T_w(\\beta)=\\e^{\\ii\\varphi}\\,\\frac{s-(1-u)}{(1-u)+s\\,u}\\;\\xrightarrow[\\;s\\to0\\;]{}\\;-\\e^{\\ii\\varphi}",
    "eq:stable-potential": "f=\\frac1N\\Bigl[\\sum_{j=1}^{N-1}\\bigl(\\Lambda-2\\ln|(1-u_j)-s|\\bigr)\n-\\Lambda+2\\ln|(1-u_N)-s|\\Bigr]",
    "eq:state-one": "\\dot\\theta_j=\\sin A\\cdot\n\\begin{cases}\n\\phantom{-}\\lambda/N, & j\\le N-1,\\\\\n\\phantom{-}\\kappa-\\frac{N-1}{N}\\lambda, & j=N,\\\\\n\\phantom{-}0, & N<j\\le N+l,\\\\\n-\\kappa+\\frac{N-1}{N}\\lambda, & j=N+l+1,\\\\\n-\\lambda/N, & j\\ge N+l+2 .\n\\end{cases}",
    "eq:state-two": "\\dot\\theta_{N+1}=\\kappa\\sin A,\\qquad \\dot\\theta_{N+l}=-\\kappa\\sin A,\\qquad\n\\dot\\theta_j=0\\ \\text{ otherwise.}",
    "eq:tau": "0=\\lambda_1<\\lambda_2\\le\\dots,\\qquad \\tau:=\\frac{1}{\\lambda_2}",
    "eq:v-def": "w=\\tanh\\!\\frac\\rho2\\;\\e^{\\ii\\varphi},\\qquad v:=\\rho\\,\\e^{\\ii\\varphi},\\qquad\n\\rho=2\\operatorname{artanh}|w|",
    "eq:v-dot": "\\dot v=-\\lambda\\Bigl[\\frac{1+c}{2}\\,q+\\frac{k}{2}\\,v^2\\,\\conj q\\Bigr],\\qquad\nc=\\frac{\\rho}{\\sinh\\rho},\\qquad k=\\frac{1-c}{\\rho^2}",
    "eq:w-dot": "\\dot w =-\\frac\\lambda2\\,(1-|w|^2)\\,q",
    "eq:w-dot-general": "\\dot w =-\\tfrac12\\,(1-|w|^2)\\,\\conj\\zeta\\,H",
    "eq:ws-ansatz": "z_j(t)=\\zeta(t)\\,\\T_{w(t)}(\\beta_j)=\\zeta\\,\\frac{\\beta_j-w}{1-\\conj w\\,\\beta_j},\n\\qquad |\\zeta|=1,\\quad |w|<1,\\quad |\\beta_j|=1",
    "eq:zeta-dot-general": "\\dot\\zeta =-\\tfrac12\\,\\bigl(\\conj w\\,H-w\\,\\conj H\\,\\zeta^2\\bigr)"
  }
}
